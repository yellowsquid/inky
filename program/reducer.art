let Bool = [T: <>; F: <>] in
let or (x : Bool) (y : Bool) : Bool =
  match x with {T u => T <>; F u => y}
in
let Nat = data N [Z: <>; S: N] in
let add (k : Nat) (n : Nat) : Nat =
  matchrec k with {Z u => n; S ind => ~(S ind)}
in
let SysT =
  data T
    [ Var: Nat
    ; Zero: <>
    ; Suc: T
    ; Primrec: <Zero: T; Suc: T; Target: T>
    ; Abs: T
    ; App: <Fun: T; Arg: T>
    ]
in
let lift (ren : Nat -> Nat) (x : Nat) : Nat =
  match !x with {Z u => ~(Z <>); S k => ~(S (ren k))}
in
let rename (t : SysT) : (Nat -> Nat) -> SysT =
  matchrec t with
    { Var n => \f => ~(Var (f n))
    ; Zero ind => \f => ~(Zero <>)
    ; Suc ind => \f => ~(Suc (ind f))
    ; Primrec ind => \f =>
      ~(Primrec
         < Zero: ind.Zero f
         ; Suc: ind.Suc (lift f)
         ; Target: ind.Target f
         >)
    ; Abs ind => \f => ~(Abs (ind (lift f)))
    ; App ind => \f =>
      ~(App <Fun: ind.Fun f; Arg: ind.Arg f>)
    }
in
let SysTSub = <Term: SysT; Index: Nat> in
let lookup (sub : SysTSub) : Nat -> SysT =
  let helper : Nat -> Nat -> SysT =
    matchrec sub.Index with
      { S ind => \extra, var =>
        match !var with
          { S n => ind ~(S extra) n
          ; Z u => ~(Var extra)
          }
      ; Z ind => \extra, var =>
        match !var with
          { S n => ~(Var (add extra n))
          ; Z v => rename sub.Term (add extra)
          }
      }
  in
  helper ~(Z <>)
in
let liftSub (sub : SysTSub) : SysTSub =
  <Term: sub.Term; Index: ~(S sub.Index)>
in
let sub (t : SysT) : SysTSub -> SysT =
  matchrec t with
    { Var n => \sub => lookup sub n
    ; Zero ind => \sub => ~(Zero <>)
    ; Suc ind => \sub => ~(Suc (ind sub))
    ; Primrec ind => \sub =>
      ~(Primrec
         < Zero: ind.Zero sub
         ; Suc: ind.Suc (liftSub sub)
         ; Target: ind.Target sub
         >)
    ; Abs ind => \sub => ~(Abs (ind (liftSub sub)))
    ; App ind => \sub =>
      ~(App <Fun: ind.Fun sub; Arg: ind.Arg sub>)
    }
in
let RedResult = <Term: SysT; Progress: Bool> in
let app (fun : SysT) (arg : SysT) : RedResult =
  let default : RedResult =
    < Term: ~(App <Fun: fun; Arg: arg>)
    ; Progress: F <>
    >
  in
  match !fun with
    { Var n => default
    ; Zero u => default
    ; Suc t => default
    ; Primrec p => default
    ; Abs t =>
      < Term: sub t <Term: arg; Index: ~(Z <>)>
      ; Progress: T <>
      >
    ; App t => default
    }
in
let primrec
      (zero : SysT)
      (suc : SysT)
      (target : SysT)
      : RedResult =
  let default : RedResult =
    < Term:
      ~(Primrec
         <Zero: zero; Suc: suc; Target: target>)
    ; Progress: F <>
    >
  in
  match !target with
    { Var n => default
    ; Zero u => <Term: zero; Progress: T <>>
    ; Suc t =>
      < Term:
        sub
          suc
          < Term:
            ~(Primrec
               <Zero: zero; Suc: suc; Target: t>)
          ; Index: ~(Z <>)
          >
      ; Progress: T <>
      >
    ; Primrec p => default
    ; Abs t => default
    ; App t => default
    }
in
let singleStep (term : SysT) : RedResult =
  matchrec term with
    { Var n => <Term: ~(Var n); Progress: F <>>
    ; Zero ind => <Term: ~(Zero <>); Progress: F <>>
    ; Suc ind =>
      <Term: ~(Suc ind.Term); Progress: ind.Progress>
    ; Primrec ind =>
      match or
              (or ind.Zero.Progress ind.Suc.Progress)
              ind.Target.Progress with
        { F u =>
          primrec
            ind.Zero.Term
            ind.Suc.Term
            ind.Target.Term
        ; T u =>
          < Term:
            ~(Primrec
               < Zero: ind.Zero.Term
               ; Suc: ind.Suc.Term
               ; Target: ind.Target.Term
               >)
          ; Progress: T <>
          >
        }
    ; Abs ind =>
      <Term: ~(Abs ind.Term); Progress: ind.Progress>
    ; App ind =>
      match or ind.Fun.Progress ind.Arg.Progress with
        { F u => app ind.Fun.Term ind.Arg.Term
        ; T u =>
          < Term:
            ~(App
               <Fun: ind.Fun.Term; Arg: ind.Arg.Term>)
          ; Progress: T <>
          >
        }
    }
in
let step (term : SysT) : SysT =
  (singleStep term).Term
in
let reduce (n : Nat) : SysT -> SysT =
  matchrec n with
    { Z u => \t => t
    ; S ind => \t => ind (step t)
    }
in
reduce
