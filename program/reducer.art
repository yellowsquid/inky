let Bool = [T: <>; F: <>] in
let or (x : Bool) (y : Bool) : Bool = match x with {T u => T <>; F u => y} in
let Nat = data N [Z : <>; S : N] in
let suc (n : Nat) : Nat = ~(S n) in
let SysT =
  data T
    [ Var: Nat
    ; Zero: <>
    ; Suc: T
    ; Primrec: <Zero: T; Suc: T; Target: T>
    ; Abs: T
    ; App: <Fun: T; Arg: T>
    ]
in
let SysTList = data L [N : <>; C: <H : SysT; T: L>] in
let nil : SysTList = ~(N <>) in
let cons (x : SysT) (xs : SysTList) : SysTList = ~(C <H: x; T: xs>) in
let Stepped = <Term: SysT; Smaller: Bool> in
let lift (f : Nat -> Nat) (n : Nat) : Nat =
  match !n with {Z u => ~(Z <>); S k => suc (f k)}
in
let rename (t : SysT) : (Nat -> Nat) -> SysT =
  matchrec t with
    { Var n => \f => ~(Var (f n))
    ; Zero u => \f => ~(Zero <>)
    ; Suc r => \f => ~(Suc (r f))
    ; Primrec p => \f =>
      ~(Primrec <Zero: p.Zero f; Suc: p.Suc (lift f); Target: p.Target f>)
    ; Abs r => \f => ~(Abs (r (lift f)))
    ; App p => \f => ~(App <Fun: p.Fun f; Arg: p.Arg f>)
    }
in
let index (xs : SysTList) : Nat -> SysT =
  matchrec xs with
    { N u => \k => ~(Var k)
    ; C p => \k => match !k with {Z u => p.H; S k => p.T k}
    }
in
let shift = map (\X => data L [N : <>; C: <H : X; T:L >]) SysT SysT (\t => rename t (\x => suc x)) in
let sub (t : SysT) : SysTList -> SysT =
  matchrec t with
    { Var n => \env => index env n
    ; Zero u => \env => ~(Zero <>)
    ; Suc f => \env => ~(Suc (f env))
    ; Primrec p => \env =>
      ~(Primrec
         < Zero: p.Zero env
         ; Suc: p.Suc (cons ~(Var ~(Z <>)) (shift env))
         ; Target: p.Target env
         >)
    ; Abs f => \env => ~(Abs (f (cons ~(Var ~(Z <>)) (shift env))))
    ; App p => \env => ~(App <Fun: p.Fun env; Arg: p.Arg env>)
    }
in
let app (fun : SysT) (arg : SysT) (smaller : Bool) : Stepped =
  let default : Stepped =
    <Term: ~(App <Fun: fun; Arg: arg>); Smaller: smaller>
  in
  match !fun with
    { Var n => default
    ; Zero u => default
    ; Suc t => default
    ; Primrec p => default
    ; Abs t => <Term: sub t (cons arg nil); Smaller: T <>>
    ; App t => default
    }
in
let doRec (z : SysT) (s : SysT) (target : SysT) (smaller : Bool) : Stepped =
  let default : Stepped =
    <Term: ~(Primrec <Zero: z; Suc: s; Target: target>); Smaller: smaller>
  in
  match !target with
    { Var n => default
    ; Zero u => <Term: z; Smaller: T <>>
    ; Suc t =>
      <Term: sub s (cons ~(Primrec <Zero: z; Suc: s; Target: t>) nil); Smaller: T <>>
    ; Primrec p => default
    ; Abs t => default
    ; App t => default
    }
in
let step (t : SysT) : Stepped =
  matchrec t with
    { Var n => <Term: ~(Var n); Smaller: F <>>
    ; Zero u => <Term: ~(Zero <>); Smaller: F <>>
    ; Suc t => <Term: ~(Suc t.Term); Smaller: t.Smaller>
    ; Primrec t =>
      match t.Target.Smaller with
        { F u =>
          doRec
            t.Zero.Term
            t.Suc.Term
            t.Target.Term
            (or t.Zero.Smaller t.Suc.Smaller)
        ; T u =>
          < Term:
            ~(Primrec
               (map
                 (\X => <Zero: X; Suc: X; Target: X>)
                 Stepped
                 SysT
                 (\p => p.Term)
                 t))
          ; Smaller: T <>
          >
        }
    ; Abs t => <Term: ~(Abs t.Term); Smaller: t.Smaller>
    ; App t =>
      match t.Arg.Smaller with
        { F u => app t.Fun.Term t.Arg.Term t.Fun.Smaller
        ; T u =>
          < Term:
            ~(App (map (\X => <Fun: X; Arg: X>) Stepped SysT (\p => p.Term) t))
          ; Smaller: T <>
          >
        }
    }
in
let reduce (n : Nat) : SysT -> SysT =
  matchrec n with
    { Z u => \t => t
    ; S f => \t =>
      let stepped = step t in
      match stepped.Smaller with {F u => stepped.Term; T u => f stepped.Term}
    }
in
reduce
